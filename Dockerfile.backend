# CodeGym backend: Go binary + python3/go toolchain for real code execution.
#
# Build from the repository root:
#   docker build -f Dockerfile.backend -t codegym-backend .
#
# The runtime image intentionally keeps the Go toolchain so `go run`-judged
# questions work out of the box; python3 is installed for Python questions.
FROM golang:1.26-alpine AS build
WORKDIR /src
COPY backend/go.mod backend/go.sum ./
RUN go mod download
COPY backend/ .
RUN CGO_ENABLED=0 go build -o /out/codegym-server ./cmd/server

FROM golang:1.26-alpine
RUN apk add --no-cache python3 ca-certificates tzdata
WORKDIR /app
COPY --from=build /out/codegym-server ./codegym-server
COPY backend/data/bank ./data/bank

# Set a token in production! e.g. -e CODEGYM_ADMIN_TOKEN=$(openssl rand -hex 16)
ENV CODEGYM_BANK_DIR=/app/data/bank
EXPOSE 8090
VOLUME ["/app/data"]
ENTRYPOINT ["/app/codegym-server"]
CMD ["-addr", ":8090", "-db", "/app/data/codegym.db"]
