      "to": "variant",
      "label": "full_code + fill_points"
    },
    {
      "id": "variant-to-editor",
      "from": "variant",
      "to": "editor",
      "label": "掩码变体标记",
      "variant": "emphasis",
      "labelDy": 34
    },
    {
      "id": "editor-to-judge",
      "from": "editor",
      "to": "judge",
      "label": "学员答案 · hint_usage"
    },
    {
      "id": "judge-to-progress",
      "from": "judge",
      "to": "progress",
      "label": "作答记录 · 薄弱部位",
      "variant": "emphasis",
      "labelDy": 58
    }
  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "装载不变量",
      "items": [
        "题库 JSON 不存坐标，seed 按原文重算 span，改代码无需算位置",
        "ensureBeginnerPoint 保证每题入门负重至少一个可填点",
        "教练端/AI 落库绕过 seed，直接 upsert exercises",
        "seed 的 upsert 只动 exercises 表，绝不改进度与收藏"
      ]
    },
    {
      "dot": "violet",
      "title": "判题依据",
      "items": [
        "判题答案取自 exercises 表的 original_text / expected_output",
        "python/go 真实执行比对 stdout，其余技术栈答案匹配",
        "结果写 attempt_records 并驱动薄弱部位与打卡"
      ]
    }
  ]
}